<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rajat.pfa.gmail</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/rajat/AntiGravity/Personal finance Agent/.venv/bin/python</string>
        <string>/Users/rajat/AntiGravity/Personal finance Agent/scripts/gmail_statement_fetch.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/rajat/AntiGravity/Personal finance Agent</string>
    <!-- Run daily at 08:30 IST (03:00 UTC). Statements typically land overnight. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>3</integer>
        <key>Minute</key><integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/rajat/finance-logs/gmail_fetch.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/rajat/finance-logs/gmail_fetch.stderr.log</string>
    <!-- Run immediately if the machine was asleep at the scheduled time -->
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
